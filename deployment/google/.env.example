# Google Drive authentication
# Point this to a service-account JSON file that has Editor access to the
# configured parent folder, or use another Application Default Credential.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/openslit-drive-service-account.json

# Optional for Google Workspace domain-wide delegation. Leave blank for a
# normal service account that was directly invited to the parent folder.
# The same value can be placed in workflow_pilot_v1.json as impersonated_user.
OPENSLIT_GOOGLE_IMPERSONATED_USER=

# Never commit credential files or access tokens.
