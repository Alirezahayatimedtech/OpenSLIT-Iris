# Copy to deployment/ai/.env and keep it private.

# Use cpu, cuda, or auto. The training code defaults to auto detection.
OPENSLIT_AI_DEVICE=auto

# Local directories. Keep all datasets, checkpoints and predictions outside Git.
OPENSLIT_AI_DATA_DIR=collaboration_runs/slit_pilot_v1
OPENSLIT_AI_OUTPUT_DIR=collaboration_runs/slit_pilot_v1/ai

# Optional cache locations for pretrained model weights.
HF_HOME=.runtime/huggingface
TORCH_HOME=.runtime/torch

# Set only when a private model repository is later approved.
HF_TOKEN=
