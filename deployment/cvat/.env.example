# Copy this file to deployment/cvat/.env before running cvat.sh.
# Keep deployment/cvat/.env private; it may contain local credentials.

# CVAT server and SDK must use matching major/minor versions.
CVAT_VERSION=v2.64.0
CVAT_HOST=localhost

# The official CVAT repository will be cloned here and excluded from Git.
# Relative paths are resolved from the OpenSLIT-Iris repository root.
CVAT_INSTALL_DIR=.runtime/cvat
CVAT_REPOSITORY=https://github.com/cvat-ai/cvat.git

# API endpoint used by openslit-cvat.
CVAT_BASE_URL=http://localhost:8080

# Preferred API authentication: create a read/write Personal Access Token in
# CVAT Profile > Security. Do not commit the token.
CVAT_ACCESS_TOKEN=

# Basic authentication fallback for a local pilot only.
CVAT_USERNAME=
CVAT_PASSWORD=
